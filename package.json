{
	"name": "@lyeve/console",
	"version": "0.28.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint:ui": "node tools/lint-ui-consistency.mjs",
		"measure:small-screens": "node tools/measure-small-screens.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"commitlint": "commitlint --edit",
		"prepare": "node scripts/setup-hooks.mjs",
		"preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.startsWith('pnpm')){console.error('This repo is pnpm only: pnpm enforces supply-chain policies the alternative ignores. Install pnpm 11, then run: pnpm install');process.exit(1)}\""
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@fontsource/inter": "5.3.0",
		"@fontsource/jetbrains-mono": "5.3.0",
		"@sveltejs/adapter-node": "^6.0.4",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"@types/qrcode": "^1.5.6",
		"@vitest/coverage-v8": "5.1.0",
		"autoprefixer": "^10.6.2",
		"husky": "^9.1.7",
		"jsdom": "^31.0.1",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.75.0",
		"@lyeve-labs/client": "0.8.0",
		"@lyeve-labs/client-rest": "^0.3.2",
		"@lyeve-labs/ui-kit": "0.64.0",
		"@tiptap/core": "^3.34.0",
		"@tiptap/extension-link": "^3.34.0",
		"@tiptap/extension-underline": "^3.34.0",
		"@tiptap/starter-kit": "^3.34.0",
		"qrcode": "^1.5.4",
		"svelte-dnd-action": "^0.9.80"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
